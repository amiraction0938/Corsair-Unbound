{
  "manifest_version": 3,
  "name": "Corsair Unbound",
  "version": "1.8.0",
  "description": "Local-first browser shield with deterministic DNR enforcement, fortress catch-all, heuristics, custom scripts, and navigation isolation.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "webNavigation",
    "tabs",
    "downloads",
    "windows",
    "notifications",
    "alarms",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Corsair Unbound",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-frame-guard.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-main-world.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["core/i18n.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false,
      "match_about_blank": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js", "core/i18n.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "commands": {
    "toggle-fortress": {
      "suggested_key": { "default": "Ctrl+Shift+F", "mac": "Command+Shift+F" },
      "description": "Toggle Fortress on current tab"
    },
    "open-dashboard": {
      "suggested_key": { "default": "Ctrl+Shift+E", "mac": "Command+Shift+E" },
      "description": "Open Corsair Dashboard"
    }
  },
  "incognito": "spanning"
}