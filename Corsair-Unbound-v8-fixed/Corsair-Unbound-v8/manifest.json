{
  "manifest_version": 3,
  "name": "Corsair Unbound",
  "version": "8.1.0",
  "description": "Local-first defensive browser runtime with protection, network observation, redirect intelligence, site graph, evidence, verification, replay and agent tools.",
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "windows",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "notifications",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Corsair Unbound",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
